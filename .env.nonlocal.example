# Non-local profile (staging/production)
# IMPORTANT: never use local defaults (projectory_local_user/projectory_local_password, header simulation) outside local development.
NODE_ENV=production
AUTH_LOCAL_DEV=false
AUTH_MODE=session
AUTH_ALLOW_HEADER_SIMULATION=false

DB_HOST=projectory-db.internal
DB_PORT=5432
DB_NAME=projectory
DB_USER=projectory_app
DB_PASSWORD=REPLACE_WITH_STRONG_SECRET

# Required secret used to encrypt SMTP passwords at rest.
# Must be a strong secret (minimum 32 characters).
SMTP_PASSWORD_ENCRYPTION_KEY=SET_VIA_RUNTIME_SECRET_MANAGER

# Recommended production password policy baseline (phased rollout can start lower and tighten).
PASSWORD_MIN_LENGTH=14
PASSWORD_MIN_UNIQUE_CHARS=10
PASSWORD_MIN_CHARACTER_CLASSES=3
PASSWORD_MAX_REPEATED_CHAR_RUN=2
PASSWORD_ENFORCE_WEAK_DENYLIST=true

# Required secret used to derive CSRF tokens for session-authenticated write requests.
# Must be a strong secret (minimum 32 characters).
AUTH_CSRF_SECRET=SET_VIA_RUNTIME_SECRET_MANAGER

# Required for reverse-proxy deployments so Express resolves original client/protocol correctly.
# Examples: true, 1, loopback, loopback,linklocal
TRUST_PROXY=1

# Import throughput / payload tuning (adjust to your traffic and abuse model).
REQUEST_BODY_LIMIT=2mb
IMPORT_RATE_LIMIT_MAX=30
IMPORT_RATE_LIMIT_WINDOW_MS=900000
IMPORT_PREVIEW_RATE_LIMIT_MAX=60
IMPORT_PREVIEW_RATE_LIMIT_WINDOW_MS=300000
IMPORT_CONFIG_RATE_LIMIT_MAX=20
IMPORT_CONFIG_RATE_LIMIT_WINDOW_MS=900000

# Optional local-only override; do not set to false in non-local runtime.
# AUTH_COOKIE_SECURE=true
