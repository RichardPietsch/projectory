# Local development profile (safe for local machines only)
NODE_ENV=development
AUTH_LOCAL_DEV=true
AUTH_MODE=hybrid
AUTH_ALLOW_HEADER_SIMULATION=true
AUTH_DEFAULT_ROLE=viewer

DB_HOST=db
DB_PORT=5432
DB_NAME=helloapp
DB_USER=projectory_local_user
DB_PASSWORD=projectory_local_password

# Required only when storing/testing SMTP credentials locally
SMTP_PASSWORD_ENCRYPTION_KEY=example-local-key-change-me-32-bytes-minimum

# Optional: keep local defaults lenient; tune to mirror non-local as needed.
# REQUEST_BODY_LIMIT=2mb
# IMPORT_RATE_LIMIT_MAX=30
# IMPORT_RATE_LIMIT_WINDOW_MS=900000
# IMPORT_PREVIEW_RATE_LIMIT_MAX=60
# IMPORT_PREVIEW_RATE_LIMIT_WINDOW_MS=300000
# IMPORT_CONFIG_RATE_LIMIT_MAX=20
# IMPORT_CONFIG_RATE_LIMIT_WINDOW_MS=900000
# PASSWORD_MIN_LENGTH=12
# PASSWORD_MIN_UNIQUE_CHARS=8
# PASSWORD_MIN_CHARACTER_CLASSES=2
# PASSWORD_MAX_REPEATED_CHAR_RUN=3
# PASSWORD_ENFORCE_WEAK_DENYLIST=true
